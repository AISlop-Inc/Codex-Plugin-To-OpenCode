{
    "name": "codex-mcp-portal",
    "version": "0.2.0",
    "description": "Expose existing Codex/ChatGPT connector tools to any stdio MCP client.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/AISlop-Inc/Codex-Plugin-To-OpenCode.git"
    },
    "engines": {
        "node": ">=24"
    },
    "private": true,
    "type": "module",
    "bin": {
        "codex-mcp-portal": "dist/bridge.js"
    },
    "files": ["dist/", "docs/", "README.md", "LICENSE"],
    "scripts": {
        "start": "node bridge.ts",
        "build": "tsc -p tsconfig.build.json",
        "prepare": "npm run build",
        "pretest": "npm run build",
        "test": "node --test bridge.test.ts cli.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^5.8.0"
    }
}
